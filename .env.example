# ==============================================================================
# Zentry — Production & Development Environment Configuration Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment & Deployment Mode
# ------------------------------------------------------------------------------
# Options: development, staging, production, test.
# In 'production', default passwords and insecure secrets abort startup immediately.
ENVIRONMENT=development

# ------------------------------------------------------------------------------
# Database Infrastructure (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:securepassword123@db:5432/security_scanner
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE_SECONDS=1800

# ------------------------------------------------------------------------------
# Broker & Worker Infrastructure (Redis + Celery)
# ------------------------------------------------------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
REDIS_SOCKET_TIMEOUT=5.0
REDIS_SOCKET_CONNECT_TIMEOUT=5.0
REDIS_MAX_CONNECTIONS=50

CELERY_WORKER_CONCURRENCY=4
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_WORKER_MAX_TASKS_PER_CHILD=50

# Broker Backpressure & Queue Saturation Guard
MAX_QUEUE_DEPTH=100

# ------------------------------------------------------------------------------
# Security, Cryptography & Authentication (MUST BE OVERRIDDEN IN PRODUCTION)
# ------------------------------------------------------------------------------
# Must be at least 32 characters in production
JWT_SECRET_KEY=replace-with-a-cryptographically-secure-random-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ------------------------------------------------------------------------------
# Trusted Reverse Proxies & Client IP Resolution
# ------------------------------------------------------------------------------
# List of trusted reverse proxy IPs or CIDR blocks from which X-Forwarded-For is honored
TRUSTED_PROXIES=["127.0.0.1","::1"]

# ------------------------------------------------------------------------------
# CORS Origins & Allowed Headers
# ------------------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]
CORS_ALLOW_METHODS=["GET","POST","OPTIONS"]
CORS_ALLOW_HEADERS=["Authorization","Content-Type","Accept","Origin","X-Requested-With"]

# ------------------------------------------------------------------------------
# Outbound Scanning & SSRF Safeguards
# ------------------------------------------------------------------------------
BLOCK_PRIVATE_TARGETS=true
OUTBOUND_PROXY_URL=
OUTBOUND_TRUST_ENV=false

# ------------------------------------------------------------------------------
# Request Size & Memory Safeguards
# ------------------------------------------------------------------------------
MAX_REQUEST_BODY_BYTES=65536

# ------------------------------------------------------------------------------
# Rate Limiting & Abuse Prevention (Sliding Window)
# ------------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10
SCAN_RATE_LIMIT_PER_MINUTE=20

# ------------------------------------------------------------------------------
# Scan Concurrency & Resource Budgets
# ------------------------------------------------------------------------------
MAX_ACTIVE_SCANS_PER_USER=3
GLOBAL_SCAN_TIMEOUT_SECONDS=180.0
MODULE_SCAN_TIMEOUT_SECONDS=60.0
STALE_SCAN_THRESHOLD_SECONDS=300.0

# ------------------------------------------------------------------------------
# Reporting & File Cache
# ------------------------------------------------------------------------------
REPORT_CACHE_DIR=/tmp/zentry_report_cache

# ------------------------------------------------------------------------------
# Logging & Diagnostics
# ------------------------------------------------------------------------------
# Options: 'text' (human readable) or 'json' (structured machine readable)
LOG_FORMAT=text
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
